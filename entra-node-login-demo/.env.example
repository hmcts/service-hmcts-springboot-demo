# Settings for web-api-marketplace's registration in the sbox tenant. Copy to .env (gitignored) and
# `npm start` reads it. No secret goes here: it is read from Key Vault on every start.
ENTRA_SIGNIN_CLIENT_ID=8d56b09c-7e56-4bbb-8aa7-b26e1fc67969
# Must be registered on that app (external-entra-id tenants/sbox/config/apps.yaml); https needs `npm run cert`.
ENTRA_REDIRECT_URI=https://localhost:3344/auth/callback
PORT=3344

# Where the client secret for the client ID above lives, read with DefaultAzureCredential: your
# `az login` session locally, the workload identity in Azure. Either must be a reader of the secret.
ENTRA_KEY_VAULT=kvspsextidsbox
ENTRA_KEY_VAULT_SECRET=entra-app-web-api-marketplace-secret
